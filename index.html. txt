<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ของขวัญวันวาเลนไทน์ - ของขวัญสำหรับแฟนที่คุณรัก</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&family=Caveat:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* ==========================================================================
           1. DESIGN SYSTEM & VARIABLES (Material Design 3 & Modern Aesthetic)
           ========================================================================== */
        :root {
            --primary-gradient: linear-gradient(135deg, #ff4d6d 0%, #ff758f 100%);
            --secondary-gradient: linear-gradient(135deg, #9d4edd 0%, #c77dff 100%);
            --accent-color: #ff4d6d;
            --accent-hover: #ff3355;
            --secondary-color: #c77dff;
            --dark-color: #2b2d42;
            --light-bg: #fff5f6;
            --white: #ffffff;
            --gray-100: #f8f9fa;
            --gray-200: #e9ecef;
            --gray-300: #dee2e6;
            --gray-600: #6c757d;
            
            /* Shadows & Blur effects */
            --shadow-sm: 0 2px 8px rgba(255, 77, 109, 0.08);
            --shadow-md: 0 8px 24px rgba(255, 77, 109, 0.12);
            --shadow-lg: 0 16px 40px rgba(255, 77, 109, 0.2);
            --glass-bg: rgba(255, 255, 255, 0.8);
            --glass-border: rgba(255, 255, 255, 0.4);
            --glass-blur: blur(12px);
            
            /* Border Radius (Material Design 3 style) */
            --radius-sm: 8px;
            --radius-md: 16px;
            --radius-lg: 24px;
            --radius-full: 9999px;
            
            /* Transition */
            --transition-smooth: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* ==========================================================================
           2. GENERAL RESETS & BASE STYLES
           ========================================================================== */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
            font-size: 16px;
        }

        body {
            font-family: 'Sarabun', sans-serif;
            background-color: var(--light-bg);
            color: var(--dark-color);
            line-height: 1.6;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
            color: inherit;
            transition: var(--transition-smooth);
        }

        img {
            max-width: 100%;
            height: auto;
            display: block;
        }

        button {
            border: none;
            outline: none;
            cursor: pointer;
            font-family: 'Sarabun', sans-serif;
            transition: var(--transition-smooth);
        }

        /* Common Container Utility */
        .container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* Section Styling */
        section {
            padding: 100px 0;
            position: relative;
        }

        .section-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title {
            font-size: 2.2rem;
            font-weight: 700;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 12px;
            position: relative;
            display: inline-block;
        }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 4px;
            background: var(--primary-gradient);
            border-radius: var(--radius-full);
        }

        .section-subtitle {
            font-size: 1rem;
            color: var(--gray-600);
            max-width: 600px;
            margin: 15px auto 0;
        }

        /* Decorative Heart Elements floating in BG */
        .bg-decor {
            position: absolute;
            pointer-events: none;
            z-index: -1;
            opacity: 0.1;
            animation: float 8s ease-in-out infinite alternate;
        }

        @keyframes float {
            0% { transform: translateY(0px) rotate(0deg); }
            100% { transform: translateY(-20px) rotate(15deg); }
        }

        /* ==========================================================================
           3. NAVBAR (Glassmorphic & Sticky Header)
           ========================================================================== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            background: var(--glass-bg);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            border-bottom: 1px solid var(--glass-border);
            transition: var(--transition-smooth);
        }

        header.scrolled {
            box-shadow: var(--shadow-md);
            background: rgba(255, 245, 246, 0.95);
        }

        .nav-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 80px;
            transition: var(--transition-smooth);
        }

        header.scrolled .nav-container {
            height: 70px;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-img {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #ff4d6d;
            box-shadow: var(--shadow-sm);
        }

        .logo-text {
            font-size: 1.3rem;
            font-weight: 700;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 32px;
            list-style: none;
        }

        .nav-links a {
            font-weight: 500;
            font-size: 1rem;
            color: var(--dark-color);
            position: relative;
            padding: 6px 0;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--primary-gradient);
            transition: var(--transition-smooth);
            border-radius: var(--radius-full);
        }

        .nav-links a:hover, .nav-links a.active {
            color: var(--accent-color);
        }

        .nav-links a:hover::after, .nav-links a.active::after {
            width: 100%;
        }

        /* Mobile Nav Toggle Icon */
        .mobile-nav-toggle {
            display: none;
            font-size: 1.5rem;
            color: var(--accent-color);
            cursor: pointer;
            z-index: 1001;
        }

        /* Shopping Cart Short-cut Button in Header */
        .nav-actions {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .btn-cart {
            background: white;
            color: var(--accent-color);
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-sm);
            position: relative;
            transition: var(--transition-smooth);
            border: 1px solid var(--glass-border);
        }

        .btn-cart:hover {
            transform: translateY(-3px);
            background: var(--primary-gradient);
            color: white;
            box-shadow: var(--shadow-md);
        }

        .cart-count {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #ff0000;
            color: white;
            font-size: 0.75rem;
            font-weight: bold;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid white;
        }

        /* ==========================================================================
           4. HERO SECTION
           ========================================================================== */
        #hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding-top: 100px;
            background: radial-gradient(circle at 80% 20%, rgba(255, 117, 143, 0.15) 0%, rgba(255, 245, 246, 0.5) 100%);
            position: relative;
            overflow: hidden;
        }

        .hero-grid {
            display: table;
            width: 100%;
        }

        .hero-col {
            display: table-cell;
            vertical-align: middle;
            width: 50%;
        }

        .hero-content {
            padding-right: 40px;
        }

        .hero-tagline {
            display: inline-block;
            padding: 8px 16px;
            background: rgba(255, 77, 109, 0.1);
            color: var(--accent-color);
            border-radius: var(--radius-full);
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 24px;
            text-transform: uppercase;
            letter-spacing: 1px;
            animation: fadeInDown 1s ease;
        }

        .hero-title {
            font-size: 3.5rem;
            font-weight: 800;
            line-height: 1.2;
            color: var(--dark-color);
            margin-bottom: 20px;
            animation: fadeInLeft 1s ease;
        }

        .hero-title span {
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-desc {
            font-size: 1.2rem;
            color: var(--gray-600);
            margin-bottom: 35px;
            animation: fadeInLeft 1.2s ease;
        }

        .hero-btns {
            display: flex;
            gap: 16px;
            animation: fadeInUp 1.4s ease;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 14px 32px;
            border-radius: var(--radius-full);
            font-weight: 600;
            font-size: 1.05rem;
            gap: 8px;
            box-shadow: var(--shadow-sm);
        }

        .btn-primary {
            background: var(--primary-gradient);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-lg);
            opacity: 0.95;
        }

        .btn-secondary {
            background: white;
            color: var(--accent-color);
            border: 2px solid var(--accent-color);
        }

        .btn-secondary:hover {
            background: rgba(255, 77, 109, 0.05);
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
        }

        .hero-image-wrapper {
            position: relative;
            padding: 20px;
            animation: fadeInRight 1s ease;
        }

        .hero-img {
            width: 100%;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-lg);
            border: 8px solid white;
            transition: var(--transition-smooth);
        }

        .hero-img:hover {
            transform: scale(1.02) rotate(1deg);
        }

        .hero-badge {
            position: absolute;
            bottom: -10px;
            left: -10px;
            background: var(--glass-bg);
            backdrop-filter: var(--glass-blur);
            border: 1px solid var(--glass-border);
            padding: 20px;
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-md);
            display: flex;
            align-items: center;
            gap: 15px;
            animation: float 6s ease-in-out infinite;
        }

        .hero-badge i {
            font-size: 2rem;
            color: var(--accent-color);
        }

        .hero-badge-txt h4 {
            font-size: 1.1rem;
            font-weight: 700;
            }

        .hero-badge-txt p {
            font-size: 0.85rem;
            color: var(--gray-600);
        }

        /* Animations */
        @keyframes fadeInLeft {
            from { opacity: 0; transform: translateX(-40px); }
            to { opacity: 1; transform: translateX(0); }
        }
        @keyframes fadeInRight {
            from { opacity: 0; transform: translateX(40px); }
            to { opacity: 1; transform: translateX(0); }
        }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ==========================================================================
           5. ABOUT SECTION
           ========================================================================== */
        #about {
            background-color: white;
            border-radius: var(--radius-lg) var(--radius-lg) 0 0;
        }

        .about-grid {
            display: table;
            width: 100%;
        }

        .about-col {
            display: table-cell;
            vertical-align: middle;
            width: 50%;
        }

        .about-img-area {
            position: relative;
            padding-right: 40px;
        }

        .about-banner-container {
            width: 100%;
            height: 380px;
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-lg);
            border: 6px solid #fff5f6;
        }

        .about-banner-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 1.5s ease;
        }

        .about-banner-container:hover img {
            transform: scale(1.1);
        }

        .about-details {
            padding-left: 20px;
        }

        .about-details h3 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--dark-color);
            margin-bottom: 20px;
        }

        .about-details p {
            font-size: 1.05rem;
            color: var(--gray-600);
            margin-bottom: 30px;
            line-height: 1.8;
        }

        .feature-cards {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .feat-card {
            display: flex;
            align-items: flex-start;
            gap: 20px;
            padding: 20px;
            background: var(--light-bg);
            border-radius: var(--radius-md);
            transition: var(--transition-smooth);
        }

        .feat-card:hover {
            transform: translateX(10px);
            background: #fff0f2;
        }

        .feat-icon {
            background: var(--primary-gradient);
            color: white;
            width: 50px;
            height: 50px;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            flex-shrink: 0;
            box-shadow: var(--shadow-sm);
        }

        .feat-content h4 {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .feat-content p {
            font-size: 0.95rem;
            color: var(--gray-600);
            margin: 0;
        }

        /* ==========================================================================
           6. PRODUCT SECTION (Filterable Grid & Search)
           ========================================================================== */
        #products {
            background: var(--light-bg);
        }

        /* Product Filtering & Controls Styling */
        .product-controls {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 24px;
            margin-bottom: 40px;
        }

        /* Search Bar styling */
        .search-box {
            position: relative;
            width: 100%;
            max-width: 450px;
        }

        .search-box input {
            width: 100%;
            padding: 14px 24px 14px 50px;
            border: 2px solid transparent;
            border-radius: var(--radius-full);
            background: white;
            box-shadow: var(--shadow-sm);
            font-family: 'Sarabun', sans-serif;
            font-size: 1rem;
            transition: var(--transition-smooth);
        }

        .search-box input:focus {
            border-color: var(--accent-color);
            box-shadow: var(--shadow-md);
            outline: none;
        }

        .search-box i {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--accent-color);
            font-size: 1.2rem;
        }

        /* Categories Filter Buttons */
        .filter-buttons {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
        }

        .filter-btn {
            background: white;
            color: var(--gray-600);
            padding: 10px 24px;
            border-radius: var(--radius-full);
            font-weight: 500;
            font-size: 0.95rem;
            border: 1px solid var(--gray-200);
            box-shadow: var(--shadow-sm);
        }

        .filter-btn:hover {
            border-color: var(--accent-color);
            color: var(--accent-color);
            transform: translateY(-2px);
        }

        .filter-btn.active {
            background: var(--primary-gradient);
            color: white;
            border-color: transparent;
            box-shadow: var(--shadow-md);
        }

        /* Product Grid */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 30px;
        }

        /* Product Card */
        .product-card {
            background: white;
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            border: 1px solid rgba(255, 77, 109, 0.05);
            transition: var(--transition-smooth);
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-lg);
            border-color: rgba(255, 77, 109, 0.2);
        }

        .prod-img-wrapper {
            position: relative;
            width: 100%;
            height: 250px;
            overflow: hidden;
            background: #fdfdfd;
        }

        .prod-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .product-card:hover .prod-img {
            transform: scale(1.1);
        }

        /* Hot/Category Badge on Card */
        .prod-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            background: var(--glass-bg);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            border: 1px solid var(--glass-border);
            padding: 5px 14px;
            border-radius: var(--radius-full);
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--accent-color);
            box-shadow: var(--shadow-sm);
            z-index: 2;
        }

        .prod-info {
            padding: 24px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .prod-cat {
            font-size: 0.8rem;
            color: var(--gray-600);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .prod-name {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--dark-color);
            margin-bottom: 12px;
            line-height: 1.4;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            height: 3.2em; /* Ensure consistent text height */
        }

        .prod-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: auto;
            padding-top: 15px;
            border-top: 1px dashed var(--gray-200);
        }

        .prod-price {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--accent-color);
        }

        .prod-price::after {
            content: ' บาท';
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--gray-600);
        }

        .btn-order {
            background: var(--primary-gradient);
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-sm);
            font-size: 1rem;
        }

        .btn-order:hover {
            transform: scale(1.1);
            box-shadow: var(--shadow-md);
        }

        /* Empty State */
        .no-results {
            grid-column: 1 / -1;
            text-align: center;
            padding: 50px 20px;
            color: var(--gray-600);
        }

        .no-results i {
            font-size: 3rem;
            color: var(--gray-300);
            margin-bottom: 15px;
        }

        /* ==========================================================================
           7. CONTACT SECTION
           ========================================================================== */
        #contact {
            background-color: white;
            border-radius: 0 0 var(--radius-lg) var(--radius-lg);
        }

        .contact-grid {
            display: table;
            width: 100%;
        }

        .contact-col {
            display: table-cell;
            vertical-align: top;
            width: 50%;
        }

        .contact-info {
            padding-right: 40px;
        }

        .contact-card {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 24px;
            background: var(--light-bg);
            border-radius: var(--radius-md);
            margin-bottom: 20px;
            border: 1px solid rgba(255, 77, 109, 0.05);
            transition: var(--transition-smooth);
        }

        .contact-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-md);
            background: #fff0f2;
        }

        .contact-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            flex-shrink: 0;
            box-shadow: var(--shadow-sm);
        }

        .contact-icon.fb {
            background: linear-gradient(135deg, #1877f2, #0d5dd6);
            color: white;
        }

        .contact-icon.line {
            background: linear-gradient(135deg, #06c755, #05b04b);
            color: white;
        }

        .contact-icon.phone {
            background: var(--primary-gradient);
            color: white;
        }

        .contact-details h4 {
            font-size: 1.15rem;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .contact-details p {
            font-size: 1rem;
            color: var(--gray-600);
            margin: 0;
        }

        .contact-details a {
            color: var(--accent-color);
            font-weight: 600;
        }

        /* Feedback/Message Form Form side */
        .contact-form-area {
            padding-left: 20px;
        }

        .form-card {
            background: white;
            padding: 40px;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-lg);
            border: 1px solid var(--gray-200);
        }

        .form-card h3 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 25px;
            color: var(--dark-color);
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            font-size: 0.95rem;
            color: var(--dark-color);
        }

        .form-control {
            width: 100%;
            padding: 12px 18px;
            border: 2px solid var(--gray-200);
            border-radius: var(--radius-md);
            font-family: 'Sarabun', sans-serif;
            font-size: 0.95rem;
            transition: var(--transition-smooth);
            background: var(--gray-100);
        }

        .form-control:focus {
            border-color: var(--accent-color);
            background: white;
            outline: none;
            box-shadow: var(--shadow-sm);
        }

        textarea.form-control {
            resize: vertical;
            min-height: 120px;
        }

        .btn-submit {
            width: 100%;
            background: var(--primary-gradient);
            color: white;
            padding: 14px;
            font-weight: 600;
            border-radius: var(--radius-full);
            box-shadow: var(--shadow-md);
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        /* ==========================================================================
           8. FOOTER
           ========================================================================== */
        footer {
            background: #111;
            color: #ccc;
