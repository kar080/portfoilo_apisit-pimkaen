            background: var(--primary-gradient);
            color: white;
            transform: translateY(-3px);
        }

        .footer-bottom {
            padding-top: 30px;
            border-top: 1px solid rgba(255,255,255,0.08);
            text-align: center;
            font-size: 0.85rem;
        }

        /* ==========================================================================
           9. MODAL & QUICK VIEW & SHOPPING CART DRAWER
           ========================================================================== */
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 2000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(17, 17, 17, 0.6);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
        }

        .modal.active {
            display: flex;
            animation: fadeIn 0.3s ease;
        }

        .modal-card {
            background: white;
            width: 100%;
            max-width: 500px;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-lg);
            overflow: hidden;
            position: relative;
            transform: translateY(30px);
            transition: var(--transition-smooth);
        }

        .modal.active .modal-card {
            transform: translateY(0);
        }

        .modal-close {
            position: absolute;
            top: 15px;
            right: 15px;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--gray-100);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--dark-color);
            z-index: 10;
            font-size: 1.1rem;
        }

        .modal-close:hover {
            background: var(--accent-color);
            color: white;
        }

        .modal-header-img {
            height: 220px;
            position: relative;
            background: #fdfdfd;
        }

        .modal-header-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .modal-body {
            padding: 30px;
        }

        .modal-cat {
            font-size: 0.85rem;
            color: var(--gray-600);
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .modal-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--dark-color);
            margin-bottom: 12px;
        }

        .modal-price {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--accent-color);
            margin-bottom: 20px;
        }

        .modal-price::after {
            content: ' บาท';
            font-size: 1rem;
            color: var(--gray-600);
            font-weight: 500;
        }

        /* Order Direct actions inside modal */
        .channel-selector {
            background: var(--light-bg);
            padding: 15px;
            border-radius: var(--radius-md);
            margin-top: 15px;
        }

        .channel-selector p {
            font-weight: 700;
            font-size: 0.9rem;
            margin-bottom: 10px;
            text-align: center;
        }

        .channel-btns {
            display: flex;
            gap: 12px;
        }

        .btn-channel {
            flex: 1;
            padding: 10px;
            border-radius: var(--radius-full);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            color: white;
        }

        .btn-channel.channel-fb {
            background: #1877f2;
        }

        .btn-channel.channel-line {
            background: #06c755;
        }

        .btn-channel:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        /* Cart Floating Sidebar/Drawer */
        .cart-drawer {
            position: fixed;
            top: 0;
            right: -400px;
            width: 100%;
            max-width: 400px;
            height: 100%;
            background: white;
            z-index: 2100;
            box-shadow: var(--shadow-lg);
            transition: var(--transition-smooth);
            display: flex;
            flex-direction: column;
        }

        .cart-drawer.active {
            right: 0;
        }

        .cart-drawer-header {
            padding: 24px;
            border-bottom: 1px solid var(--gray-200);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .cart-drawer-header h3 {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--dark-color);
        }

        .cart-close {
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--dark-color);
        }

        .cart-items-container {
            flex-grow: 1;
            overflow-y: auto;
            padding: 24px;
        }

        .cart-item {
            display: flex;
            gap: 15px;
            padding-bottom: 15px;
            margin-bottom: 15px;
            border-bottom: 1px solid var(--gray-100);
            position: relative;
        }

        .cart-item-img {
            width: 70px;
            height: 70px;
            border-radius: var(--radius-sm);
            object-fit: cover;
        }

        .cart-item-details {
            flex-grow: 1;
        }

        .cart-item-name {
            font-weight: 600;
            font-size: 0.95rem;
            margin-bottom: 4px;
            color: var(--dark-color);
        }

        .cart-item-price {
            color: var(--accent-color);
            font-weight: 700;
            font-size: 1rem;
        }

        .cart-item-qty {
            font-size: 0.85rem;
            color: var(--gray-600);
            margin-top: 4px;
        }

        .cart-item-remove {
            position: absolute;
            top: 0;
            right: 0;
            color: var(--gray-600);
            cursor: pointer;
        }

        .cart-item-remove:hover {
            color: var(--accent-color);
        }

        .cart-drawer-footer {
            padding: 24px;
            border-top: 1px solid var(--gray-200);
            background: var(--gray-100);
        }

        .cart-total-row {
            display: flex;
            justify-content: space-between;
            font-weight: 700;
            font-size: 1.15rem;
            margin-bottom: 20px;
            color: var(--dark-color);
        }

        .btn-checkout {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 14px;
            background: var(--primary-gradient);
            color: white;
            border-radius: var(--radius-full);
            font-weight: 600;
            gap: 10px;
        }

        .btn-checkout:hover {
            opacity: 0.95;
            box-shadow: var(--shadow-md);
        }

        .cart-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.4);
            backdrop-filter: blur(4px);
            z-index: 2050;
            display: none;
        }

        .cart-overlay.active {
            display: block;
        }

        /* ==========================================================================
           10. RESPONSIVE MEDIA QUERIES
           ========================================================================== */
        @media (max-width: 991px) {
            .hero-grid, .about-grid, .contact-grid {
                display: block;
            }
            .hero-col, .about-col, .contact-col {
                display: block;
                width: 100%;
            }
            .hero-content {
                padding-right: 0;
                margin-bottom: 50px;
                text-align: center;
            }
            .hero-btns {
                justify-content: center;
            }
            .hero-badge {
                left: 20px;
                bottom: 20px;
            }
            .about-img-area {
                padding-right: 0;
                margin-bottom: 40px;
            }
            .about-details {
                padding-left: 0;
            }
            .contact-info {
                padding-right: 0;
                margin-bottom: 50px;
            }
            .contact-form-area {
                padding-left: 0;
            }
        }

        @media (max-width: 768px) {
            html {
                font-size: 14px;
            }
            .hero-title {
                font-size: 2.8rem;
            }
            /* Nav Toggle */
            .mobile-nav-toggle {
                display: block;
            }
            .nav-links {
                position: fixed;
                top: 80px;
                left: -100%;
                width: 100%;
                height: calc(100vh - 80px);
                background: white;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 40px;
                transition: var(--transition-smooth);
                z-index: 999;
                box-shadow: var(--shadow-lg);
            }
            .nav-links.active {
                left: 0;
            }
            header.scrolled .nav-links {
                top: 70px;
                height: calc(100vh - 70px);
            }
        }
    </style>
</head>
