    <script>
        // 1. RAW DATA DEFINITIONS (Supplied by Client)
        const productsData = [
            { id: 1, name: "ช่อดอกกุหลาบ", price: 150, category: "ดอกไม้", img: "https://www.aflowerroom.com/wp-content/uploads/2019/12/A064_White.jpg" },
            { id: 2, name: "ดอกทิวลิป", price: 140, category: "ดอกไม้", img: "https://flowerlabbychanana.com/wp-content/uploads/2021/04/File_118.jpeg" },
            { id: 3, name: "ดอกเดชื่", price: 170, category: "ดอกไม้", img: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRQTwZeOo-_W4eQiXwshBZSBi3ZxHvHFbY_r2a1AiFZPZFVxt9_FkgfnYQ&s=10" },
            { id: 4, name: "ตุ๊กตาหมีสีชมพูถือหัวใจ", price: 210, category: "ตุ๊กตา", img: "https://down-th.img.susercontent.com/file/8991049733d83515a9d5419bb37dea6a" },
            { id: 5, name: "ตุ๊กตาหมีสีขาวใส่เสื้อลาย", price: 250, category: "ตุ๊กตา", img: "https://img.priceza.com/img1/314/1056/314-20240129065020-162463632943749556.jpg" },
            { id: 6, name: "ตุ๊กตาหมี2ตัวสีน้ำตาลและสีขาวถือดอกไม้", price: 240, category: "ตุ๊กตา", img: "https://sg-test-11.slatic.net/p/fc60e9effe2539917128b1bb93ca3f4d.jpg" },
            { id: 7, name: "สร้อยคอหัวใจแม่เหล็ก", price: 150, category: "สร้อยคอและข้อมือ", img: "https://down-th.img.susercontent.com/file/cn-11134207-7r98o-lq068i7al7w502" },
            { id: 8, name: "สร้อยข้อมือ", price: 215, category: "สร้อยคอและข้อมือ", img: "https://down-th.img.susercontent.com/file/9df1a6c4051a3b3fe7f9301bfc764b21" },
            { id: 9, name: "กล่องขนมช็อกโกแลตทรัฟเฟิล", price: 400, category: "กล่องของขวัญ", img: "https://www.cozxy.com/images/Content/chocolate-2_mobile-2.jpg" },
            { id: 10, name: "กล่องเปล่าใส่ของ", price: 15, category: "กล่องของขวัญ", img: "https://down-th.img.susercontent.com/file/sg-11134201-8227b-mhlnx37s69z527" }
        ];

        // Contacts URL
        const fbUsername = "abhisit.pimkaen";
        const lineUsername = "abhisit.pimkaen";
        const lineUrl = `https://line.me/ti/p/~${lineUsername}`;
        const fbUrl = `https://m.me/${fbUsername}`;

        // Cart State
        let cart = [];

        // DOM Elements
        const productContainer = document.getElementById("product-container");
        const searchInput = document.getElementById("search-input");
        const filterBtns = document.querySelectorAll(".filter-btn");
        const menuToggle = document.getElementById("menu-toggle");
        const navMenu = document.getElementById("nav-menu");
        const mainHeader = document.getElementById("main-header");
        
        // Modal elements
        const prodModal = document.getElementById("prod-modal");
        const closeModalBtn = document.getElementById("close-modal-btn");
        const modalImg = document.getElementById("modal-img");
        const modalCat = document.getElementById("modal-cat");
        const modalTitle = document.getElementById("modal-title");
        const modalPrice = document.getElementById("modal-price");
        const modalFbBtn = document.getElementById("modal-fb-btn");
        const modalLineBtn = document.getElementById("modal-line-btn");

        // Cart Drawer elements
        const cartOverlay = document.getElementById("cart-overlay");
        const cartDrawer = document.getElementById("cart-drawer");
        const openCartBtn = document.getElementById("open-cart-btn");
        const closeCartDrawerBtn = document.getElementById("close-cart-drawer-btn");
        const cartCounter = document.getElementById("cart-counter");
        const cartQtySpan = document.getElementById("cart-qty-span");
        const cartTotalSpan = document.getElementById("cart-total-span");
        const cartItemsContainer = document.getElementById("cart-items-container");
        const cartCheckoutBtn = document.getElementById("cart-checkout-btn");

        // 2. RENDERING AND FILTERING FUNCTIONS
        let activeFilter = 'all';
        let searchQuery = '';

        function renderProducts() {
            productContainer.innerHTML = '';
            
            // Filter products
            const filtered = productsData.filter(p => {
                const matchesFilter = activeFilter === 'all' || p.category === activeFilter;
                const matchesSearch = p.name.toLowerCase().includes(searchQuery.toLowerCase()) || 
                                      p.category.toLowerCase().includes(searchQuery.toLowerCase());
                return matchesFilter && matchesSearch;
            });

            if (filtered.length === 0) {
                productContainer.innerHTML = `
                    <div class="no-results">
                        <i class="fa-solid fa-heart-crack"></i>
                        <p>ขออภัยค่ะ ไม่พบของขวัญที่คุณค้นหา ลองระบุคำอื่นแทนนะคะ</p>
                    </div>
                `;
                return;
            }

            filtered.forEach(p => {
                const card = document.createElement("div");
                card.className = "product-card";
                card.innerHTML = `
                    <span class="prod-badge">${p.category}</span>
                    <div class="prod-img-wrapper">
                        <img class="prod-img" src="${p.img}" alt="${p.name}" loading="lazy" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1549465220-1a8b9238cd48?auto=format&fit=crop&q=80&w=600'">
                    </div>
                    <div class="prod-info">
                        <span class="prod-cat">หมวด ${p.category}</span>
                        <h3 class="prod-name">${p.name}</h3>
                        <div class="prod-bottom">
                            <span class="prod-price">${p.price}</span>
                            <button class="btn-order" onclick="openProductDetail(${p.id})" title="ดูรายละเอียดเพื่อสั่งซื้อ">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </div>
                    </div>
                `;
                productContainer.appendChild(card);
            });
        }

        // Setup filter click events
        filterBtns.forEach(btn => {
            btn.addEventListener("click", () => {
                filterBtns.forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
                activeFilter = btn.getAttribute("data-filter");
                renderProducts();
            });
        });

        // Setup search input keyboard event
        searchInput.addEventListener("input", (e) => {
            searchQuery = e.target.value;
            renderProducts();
        });

        // 3. CART SYSTEM (Pure client logic, extremely useful for smooth UX)
        function updateCartUI() {
            // Count total qty and price
            const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            // Update badges/texts
            cartCounter.innerText = totalQty;
            cartQtySpan.innerText = totalQty;
            cartTotalSpan.innerText = totalPrice;

            // Render items in drawer
            cartItemsContainer.innerHTML = '';
            if (cart.length === 0) {
                cartItemsContainer.innerHTML = `
                    <div style="text-align: center; color: var(--gray-600); padding-top: 50px;">
                        <i class="fa-solid fa-basket-shopping" style="font-size: 2.5rem; color: var(--gray-300); margin-bottom: 10px;"></i>
                        <p>ยังไม่มีของขวัญที่คุณสนใจในรายการค่ะ</p>
                    </div>
                `;
            } else {
                cart.forEach(item => {
                    const cartItemEl = document.createElement("div");
                    cartItemEl.className = "cart-item";
                    cartItemEl.innerHTML = `
                        <img src="${item.img}" alt="${item.name}" class="cart-item-img">
                        <div class="cart-item-details">
                            <div class="cart-item-name">${item.name}</div>
                            <div class="cart-item-price">${item.price} บาท</div>
                            <div class="cart-item-qty">จำนวน: ${item.qty} ชิ้น</div>
                        </div>
                        <i class="fa-solid fa-trash-can cart-item-remove" onclick="removeFromCart(${item.id})"></i>
                    `;
                    cartItemsContainer.appendChild(cartItemEl);
                });
            }
        }

        function addToCart(productId) {
            const product = productsData.find(p => p.id === productId);
            if (!product) return;

            const existingItem = cart.find(item => item.id === productId);
            if (existingItem) {
                existingItem.qty += 1;
            } else {
                cart.push({ ...product, qty: 1 });
            }

            updateCartUI();
            
            // Pulse effect animation on cart button
            openCartBtn.style.transform = "scale(1.2)";
            setTimeout(() => {
                openCartBtn.style.transform = "none";
            }, 200);
        }

        function removeFromCart(productId) {
            cart = cart.filter(item => item.id !== productId);
            updateCartUI();
        }

        // Send order list via LINE chat integration
        cartCheckoutBtn.addEventListener("click", () => {
            if (cart.length === 0) {
                alert("กรุณาเลือกรายการสินค้าก่อนนำส่งนะคะ!");
                return;
            }

            let msg = `สวัสดีครับ สนใจสั่งของขวัญวันวาเลนไทน์รายการดังต่อไปนี้:\n`;
            cart.forEach((item, index) => {
                msg += `${index + 1}. ${item.name} (ราคา ${item.price}บ.) จำนวน ${item.qty} ชิ้น\n`;
            });
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            msg += `รวมทั้งสิ้น ${totalPrice} บาทครับ`;

            const fullLineUrl = `${lineUrl}?text=${encodeURIComponent(msg)}`;
            window.open(fullLineUrl, '_blank');
        });

        // 4. MODAL DETAILED VIEW INTERACTION
        window.openProductDetail = function(productId) {
            const product = productsData.find(p => p.id === productId);
            if (!product) return;

            // Update Modal Data
            modalImg.src = product.img;
            modalImg.onerror = function() {
                this.src = "https://images.unsplash.com/photo-1549465220-1a8b9238cd48?auto=format&fit=crop&q=80&w=600";
            };
            modalCat.innerText = `หมวดหมู่: ${product.category}`;
            modalTitle.innerText = product.name;
            modalPrice.innerText = product.price;

            // Generate customized Chat Direct message links
            const chatMessage = `สวัสดีครับ ผมอยากสอบถามหรือสั่งซื้อชิ้นนี้: ${product.name} (ราคา ${product.price} บาท) ครับ`;
            modalFbBtn.href = `${fbUrl}?text=${encodeURIComponent(chatMessage)}`;
            modalLineBtn.href = `${lineUrl}?text=${encodeURIComponent(chatMessage)}`;

            // Open Modal
            prodModal.classList.add("active");
            
            // Automatically queue into interest cart drawer silently
            addToCart(product.id);
        };

        closeModalBtn.addEventListener("click", () => {
            prodModal.classList.remove("active");
        });

        // Close modal when clicking outside
        prodModal.addEventListener("click", (e) => {
            if (e.target === prodModal) {
                prodModal.classList.remove("active");
            }
        });

        // 5. CART DRAWER TOGGLES
        openCartBtn.addEventListener("click", () => {
            cartDrawer.classList.add("active");
            cartOverlay.classList.add("active");
        });

        closeCartDrawerBtn.addEventListener("click", () => {
            cartDrawer.classList.remove("active");
            cartOverlay.classList.remove("active");
        });

        cartOverlay.addEventListener("click", () => {
            cartDrawer.classList.remove("active");
            cartOverlay.classList.remove("active");
        });

        // 6. RESPONSIVE NAVIGATION MENU TOGGLE
        menuToggle.addEventListener("click", () => {
            navMenu.classList.toggle("active");
            const icon = menuToggle.querySelector("i");
            if (navMenu.classList.contains("active")) {
                icon.className = "fa-solid fa-times";
            } else {
                icon.className = "fa-solid fa-bars";
            }
        });

        // Close mobile nav when link clicked
        document.querySelectorAll(".nav-link").forEach(link => {
            link.addEventListener("click", () => {
                navMenu.classList.remove("active");
                menuToggle.querySelector("i").className = "fa-solid fa-bars";
            });
        });

        // Header Style change on Scroll
        window.addEventListener("scroll", () => {
            if (window.scrollY > 50) {
                mainHeader.classList.add("scrolled");
            } else {
                mainHeader.classList.remove("scrolled");
            }

            // Highlights current scroll section in Navbar
            const sections = document.querySelectorAll("section");
            const scrollPos = window.scrollY + 150;

            sections.forEach(section => {
                if (scrollPos >= section.offsetTop && scrollPos < section.offsetTop + section.offsetHeight) {
                    const activeId = section.getAttribute("id");
                    document.querySelectorAll(".nav-link").forEach(link => {
                        link.classList.remove("active");
                        if (link.getAttribute("href") === `#${activeId}`) {
                            link.classList.add("active");
                        }
                    });
                }
            });
        });

        // 7. FEEDBACK FORM SUBMISSION INTERACTIVE (Client Mock Response)
        const msgForm = document.getElementById("msg-form");
        msgForm.addEventListener("submit", (e) => {
            e.preventDefault();
            const name = document.getElementById("sender-name").value;
            const contact = document.getElementById("sender-contact").value;
            const msg = document.getElementById("sender-msg").value;

            // Display romantic, beautifully matched alerts
            alert(`ขอบคุณคุณ ${name} มากๆ เลยนะคะ! ข้อความของคุณได้จัดเตรียมเรียบร้อยแล้ว ระบบกำลังพาท่านไปส่งรายละเอียดเพิ่มเติมทาง LINE เพื่อให้เจ้าหน้าที่ดูแลทันทีค่ะ`);
            
            // Redirect smoothly to customer support Line
            const textToLink = `สวัสดีครับ/ค่ะ ชื่อ ${name} จากระบบติดต่อหน้าร้าน อยากติดต่อสอบถามรายละเอียดดังนี้:\n- เบอร์ติดต่อกลับ: ${contact}\n- ข้อความ: ${msg}`;
            window.open(`${lineUrl}?text=${encodeURIComponent(textToLink)}`, '_blank');
            
            msgForm.reset();
        });

        // Initial rendering
        renderProducts();
    </script>
</body>
